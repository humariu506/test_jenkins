pipeline {
    agent any

    environment {
        // L'utilisateur Jenkins doit avoir les droits d'écriture sur ce dossier
        INSTALL_DIR = "/var/www/app_tri"
    }

    // Lancé par tri-preprod quand la pré-prod est verte, avec le commit analysé.
    // Lancé à la main avec COMMIT vide : dernier commit de main.
    parameters {
        string(name: 'COMMIT', defaultValue: '', description: 'Commit à installer (vide : dernier commit de main)')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def commit = checkout(scm).GIT_COMMIT
                    if (params.COMMIT) {
                        if (!(params.COMMIT ==~ /[0-9a-f]{7,40}/)) {
                            error "COMMIT invalide : ${params.COMMIT}"
                        }
                        sh "git checkout --quiet --detach ${params.COMMIT}"
                        commit = params.COMMIT
                    }
                    env.COMMIT_TESTE = commit
                }
                echo "Commit installé : ${env.COMMIT_TESTE}"
            }
        }
        stage('Compilation Release') {
            steps {
                sh 'make distclean'
                sh 'make'
            }
        }
        stage('Tests') {
            steps {
                sh 'make test'
            }
        }
        stage('Nettoyage') {
            steps {
                // Supprime .o et binaire de test, conserve l'exécutable tri_bulles
                sh 'make clean'
            }
        }
        stage('Strip') {
            steps {
                sh 'ls -l tri_bulles && file tri_bulles'
                sh 'make strip'
                sh 'ls -l tri_bulles && file tri_bulles'
                sh './tri_bulles 5 2 8 1 3'
            }
        }
        stage('Installation') {
            steps {
                sh "make install PREFIX=${INSTALL_DIR}"
                sh "ls -l ${INSTALL_DIR}/bin/tri_bulles"
            }
        }
    }
    post {
        always {
            cleanWs()
        }
        success {
            echo "Déploiement en production terminé : ${INSTALL_DIR}/bin/tri_bulles (commit ${env.COMMIT_TESTE})"
        }
        failure {
            echo 'Échec du déploiement : la production garde la version précédente.'
        }
    }
}
