pipeline {
    agent any

    environment {
        // L'utilisateur Jenkins doit avoir les droits d'écriture sur ce dossier
        INSTALL_DIR = "/var/www/app_tri"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Compilation Release') {
            steps {
                sh 'make distclean'
                sh 'make'
            }
        }
        stage('Tests') {
            steps {
                sh 'make test'
            }
        }
        stage('Nettoyage') {
            steps {
                // Supprime .o et binaire de test, conserve l'exécutable tri_bulles
                sh 'make clean'
            }
        }
        stage('Strip') {
            steps {
                sh 'ls -l tri_bulles && file tri_bulles'
                sh 'make strip'
                sh 'ls -l tri_bulles && file tri_bulles'
                sh './tri_bulles 5 2 8 1 3'
            }
        }
        stage('Installation') {
            steps {
                sh "make install PREFIX=${INSTALL_DIR}"
                sh "ls -l ${INSTALL_DIR}/bin/tri_bulles"
            }
        }
    }
    post {
        always {
            cleanWs()
        }
        success {
            echo "Déploiement en production terminé : ${INSTALL_DIR}/bin/tri_bulles"
        }
        failure {
            echo 'Échec du déploiement en production.'
        }
    }
}
